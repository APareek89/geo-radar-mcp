# ─────────────────────────────────────────────────────────────────────────────
# GEO Radar MCP — environment. Copy to `.env` and fill in. NEVER commit `.env`.
# The server only ever checks that a key is PRESENT, never logs its value.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required (v1) ────────────────────────────────────────────────────────────
# Anthropic Haiku: used as the parser/scorer AND as a panelist. (~cents per audit)
ANTHROPIC_API_KEY=

# Postgres (SoV time-series). Default below matches docker-compose.yml.
# Leave as-is for local Docker, or set to your own connection string in .env (never here).
DATABASE_URL=postgresql://geo:geo@localhost:5432/geo_radar

# Redis (queue + cache + rate-limit). Default below matches docker-compose.yml.
REDIS_URL=redis://localhost:6379

# ── Panelists — v1 enables Gemini + Groq + Perplexity (enable >= 1) ──────────
GEMINI_API_KEY=
GROQ_API_KEY=
PERPLEXITY_API_KEY=
# Optional extra panelist:
OPENAI_API_KEY=

# ── Optional: AI-traffic attribution (GA4) — enables attribute_ai_traffic ────
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# ── Hosted HTTP mode (only when publishing the remote server) ────────────────
# stdio | http
MCP_TRANSPORT=stdio
PORT=8080
# PANEL_RUNNER=queue  # offload panel runs to BullMQ workers (needs REDIS_URL)

# Auth for HTTP mode (pick ONE; leave all blank for open local dev):
#  (a) Simple bearer token — clients send  Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=
#  (b) Delegated OAuth — an external authorization server (e.g. WorkOS AuthKit)
#      handles login/DCR; we only verify the JWT. Set your AuthKit domain as the
#      issuer and your public MCP URL as the audience (WorkOS "resource indicator").
OAUTH_ISSUER=
OAUTH_AUDIENCE=
# OAUTH_JWKS_URI=   # optional override; auto-discovered from the issuer metadata otherwise

# ── Observability (free tiers) ───────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Cost guardrail — hard spend cap per panel run ────────────────────────────
PANEL_COST_CAP_USD_PER_RUN=1.00
