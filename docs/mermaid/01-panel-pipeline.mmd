flowchart TD
  %% GEO Radar MCP — DIAGRAM 01: the panel pipeline (what measure_share_of_voice runs)
  %% This is the "fresh panel" box from the master flow, fully granular.

  entry["measure_share_of_voice(brand, competitors, prompts|prompt_set_id, panel, runs)<br/>[FUNCTION]<br/>out: typed input"]:::fn
  workload{"Workload OK?<br/>[FUNCTION · prompts x runs x panel <= MAX_PANELIST_CALLS=240]"}:::dec
  tooBig["Reject · workload_too_large<br/>[FUNCTION]"]:::term

  mode{"PANEL_RUNNER?<br/>[FUNCTION]"}:::dec
  inproc["InProcessPanelRunner<br/>[FUNCTION · runs synchronously]"]:::fn
  queue["QueuePanelRunner → BullMQ<br/>[LIBRARY · Redis]<br/>enqueue (attempts=1, no re-spend) → worker runs it"]:::data

  begin["beginRun · find-or-create brand + competitors<br/>[DATA · Postgres]<br/>status=running · out: report_id + brandId"]:::data

  costgate{"Cost gate BEFORE each call<br/>[FUNCTION · projected spend <= PANEL_COST_CAP_USD_PER_RUN]"}:::dec
  abort["Abort · cost_cap_exceeded<br/>[FUNCTION]<br/>out: error, run marked failed"]:::term

  panelist["Panelist answers the prompt<br/>[AGENT · Haiku | Gemini | Groq | Perplexity]<br/>real if provider key present, else deterministic mock<br/>out: raw answer + token usage"]:::agent
  parse["Parse the answer<br/>[AGENT · Haiku · structured output]<br/>out: mentions, cited_domains, sentiment"]:::agent
  meter["Add usage to CostMeter<br/>[FUNCTION]<br/>out: running USD total"]:::fn

  loop{"More prompt x run x panelist?<br/>[FUNCTION]"}:::dec
  score["Score share-of-voice<br/>[FUNCTION · deterministic]<br/>in: parsed answers · out: SoV per brand + per-prompt"]:::fn
  finish["finishRun · ONE transaction<br/>[DATA · Postgres]<br/>insert answers + update run + insert sov_history row"]:::data
  out["Return report_id + summary<br/>[FUNCTION]<br/>(get_report / track_citations / sentiment_scan read it later)"]:::term

  entry --> workload
  workload -->|"too big"| tooBig
  workload -->|"ok"| mode
  mode -->|"in-process (default)"| inproc
  mode -->|"queue"| queue
  queue --> inproc
  inproc --> begin --> costgate
  costgate -->|"would exceed"| abort
  costgate -->|"under cap"| panelist --> parse --> meter --> loop
  loop -->|"yes"| costgate
  loop -->|"no"| score --> finish --> out

  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
